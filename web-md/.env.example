# ============================================================
# myDhamma web-md — profil environment (CONTOH).
# Copy jadi `.env` di server, isi nilainya, load via systemd EnvironmentFile
# atau `set -a; . .env; set +a` sebelum gunicorn.
# Semua ini override default di app.py -> migrasi = isi file ini, JANGAN sentuh kode.
# ============================================================

# ---- LLM chat backend ----
CHAT_BACKEND=api                  # "api" (OpenAI-compatible: OpenRouter/DeepInfra/Gemini, prod no GPU) | "ollama" (lokal/dev)
LLM_API_KEY=                      # WAJIB kalau backend=api (key provider, mis. sk-or-... utk OpenRouter). Kosong -> chat 401 + warning saat boot.
MYDHAMMA_CHAT_MODEL=google/gemma-...     # ID PERSIS dari openrouter.ai/models. Rekomendasi: 26B-A4B (near-31B, native FC+structured-output, hemat+cepat). Escape hatch kalau kepatuhan Pali/citation slip: 31B dense. Lantai: 12B (= gemma4:12b lokal).
LLM_APP_URL=https://mydhamma.app  # atribusi (header ala OpenRouter; provider lain abaikan; ganti ke domain aslimu)
LLM_APP_NAME=myDhamma
# LLM_API_BASE=https://openrouter.ai/api/v1   # ganti ke provider OpenAI-compatible lain utk lebih murah:
#   DeepInfra: https://api.deepinfra.com/v1/openai | Together: https://api.together.xyz/v1
#   Fireworks: https://api.fireworks.ai/inference/v1 | Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   -> cukup ganti base + LLM_API_KEY (pakai key provider itu) + MYDHAMMA_CHAT_MODEL (id model provider itu).
# OLLAMA_URL=http://127.0.0.1:11434      # cuma dipakai kalau backend=ollama

# ---- Embedding & reranker (VPS CPU-only) ----
EMBED_DEVICE=cpu                         # tetap cpu di VPS tanpa GPU (udah default di app.py)
MYDHAMMA_CHAT_RERANK=1                    # XL(8GB): 1 (kualitas exp5). L(4GB): 0 (hemat ~2.3GB RAM).
MYDHAMMA_SEARCH_RERANK=1                  # idem; kalau CPU lambat, boleh 0 khusus search.
# MYDHAMMA_CHAT_RERANK_TOP=48            # turunin (mis. 24) kalau rerank CPU kelambatan.

# ---- HuggingFace cache (biar model & reranker ga ke-download ulang tiap deploy) ----
HF_HOME=/srv/mydhamma/hf-cache

# ---- Server & rahasia ----
FLASK_SECRET_KEY=                        # rahasia sesi Flask; kosong -> fallback ke file web-md/.flask_secret. Prod: isi (mis. `python -c "import os;print(os.urandom(24).hex())"`).
PORT=5002
# MYDHAMMA_SKIP_WARMUP=1                 # skip warmup (mis. saat import untuk test/tooling)
